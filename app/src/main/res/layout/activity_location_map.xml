<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/gradient_background_main"
    tools:context=".MainActivity">

    <!-- Google Map Fragment -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />



    <!-- Enhanced Search Bar with Vibrant Colors -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_location"
        android:layout_width="37dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/todo"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/vibrant_teal"
        app:elevation="6dp"
        app:fabSize="mini"
        app:tint="@android:color/white" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/card_warm"
        app:cardPreventCornerOverlap="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        app:strokeColor="@color/vibrant_coral"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_search"
                app:tint="@color/vibrant_purple"
                android:alpha="0.9" />

            <EditText
                android:id="@+id/search_edittext"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:hint="@string/search_location_or_room"
                android:background="@null"
                android:padding="0dp"
                android:textSize="16sp"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:layout_gravity="top"
                android:elevation="12dp"
                android:translationZ="12dp"
                android:fontFamily="sans-serif"
                android:textColorHint="@color/text_hint_warm"
                android:textColor="@color/text_dark_warm" />

            <!-- Colorful Search Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search_address"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="@string/search"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                app:cornerRadius="22dp"
                app:backgroundTint="@color/vibrant_orange"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:elevation="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Modern Bottom Sheet with Enhanced Design -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="120dp"
        app:behavior_hideable="false">

        <!-- Enhanced Bottom Sheet Handle with Gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bottom_sheet_handle_background_gradient"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bottom_sheet_handle_colorful"
                android:alpha="0.7" />

            <View
                android:layout_width="32dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:background="@drawable/bottom_sheet_handle_colorful"
                android:alpha="0.5" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/bottom_sheet_bg"
            app:elevation="20dp"
            app:cardElevation="0dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:paddingTop="8dp">

                    <!-- Header Section with Colorful Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="47dp"
                        android:layout_marginBottom="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.02"
                            android:text="@string/make_decision"
                            android:textColor="@color/header_deep_purple"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btn_settings"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circular_background_vibrant"
                            android:clickable="true"
                            android:contentDescription="@string/settings"
                            android:focusable="true"
                            android:padding="12dp"
                            android:src="@android:drawable/ic_menu_manage"
                            app:tint="@color/vibrant_teal" />

                    </LinearLayout>

                    <!-- Quick Actions Section with Colorful Cards -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/quick_actions"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/vibrant_purple"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="2"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false"
                        android:layout_marginBottom="36dp"
                        android:padding="4dp">

                        <!-- Apartment Card with Gradient -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/apartment_card"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp"
                            android:layout_rowWeight="1"
                            app:cardCornerRadius="20dp"
                            app:strokeColor="@color/vibrant_coral"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/card_apartment"
                            app:cardElevation="4dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:stateListAnimator="@animator/card_state_animator">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">

                                <ImageView
                                    android:id="@+id/apartment"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_apartment"
                                    app:tint="@color/vibrant_teal"
                                    android:alpha="0.9" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/apartment"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_dark_warm"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Add Room Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/addRoom_card"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp"
                            android:layout_rowWeight="1"
                            app:cardCornerRadius="20dp"
                            app:strokeColor="@color/vibrant_orange"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/card_add_room"
                            app:cardElevation="4dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:stateListAnimator="@animator/card_state_animator">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">

                                <ImageView
                                    android:id="@+id/addRoom"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_addd"
                                    app:tint="@color/vibrant_green"
                                    android:alpha="0.9" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/add_room"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_dark_warm"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Language Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/language_card"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="6dp"
                            android:layout_rowWeight="1"
                            app:cardCornerRadius="20dp"
                            app:strokeColor="@color/vibrant_purple"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/card_language"
                            app:cardElevation="4dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:stateListAnimator="@animator/card_state_animator">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/ic_state"
                                    app:tint="@color/vibrant_coral"
                                    android:alpha="0.9" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/language"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_dark_warm"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </GridLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- UDSM Item with Colorful Background -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="@color/vibrant_teal"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/card_udsm"
                            app:cardElevation="3dp"
                            android:foreground="?attr/selectableItemBackground">

                            <!-- Add your UDSM content here -->

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Bus Office Item with Colorful Background -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="@color/vibrant_orange"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/card_bus"
                            app:cardElevation="3dp"
                            android:foreground="?attr/selectableItemBackground">

                            <!-- Add your Bus Office content here -->

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Language Selection with Colorful Design -->
                    <LinearLayout
                        android:id="@+id/language_selection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="32dp"
                        android:padding="16dp"
                        android:background="@drawable/language_selection_background_gradient"
                        android:visibility="gone"
                        android:gravity="center">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_english"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/english"
                            android:layout_marginEnd="12dp"
                            android:textColor="@color/text_dark_warm"
                            app:chipBackgroundColor="@color/chip_background_english"
                            app:checkedIcon="@drawable/ic_room_available"
                            app:chipIcon="@drawable/ic_english"
                            app:chipIconTint="@color/vibrant_teal" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_swahili"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/swahili"
                            android:textColor="@color/text_dark_warm"
                            app:chipBackgroundColor="@color/chip_background_swahili"
                            app:checkedIcon="@drawable/ic_room_occupied"
                            app:chipIcon="@drawable/ic_swahili"
                            app:chipIconTint="@color/vibrant_orange" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Fixed Bottom Navigation with Colorful Design -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@color/bottom_nav_bg"
        android:elevation="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:weightSum="3">

        <!-- Menu Tab -->
        <LinearLayout
            android:id="@+id/tab_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/home"
                app:tint="@color/vibrant_purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:textSize="12sp"
                android:textColor="@color/vibrant_purple"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- SELECT Tab -->
        <LinearLayout
            android:id="@+id/tab_SELECT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/vibrant_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu"
                android:textSize="12sp"
                android:textColor="@color/vibrant_teal"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Profile Tab -->
        <LinearLayout
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/vibrant_coral" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:textSize="12sp"
                android:textColor="@color/vibrant_coral"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Loading Overlay with Colorful Tint -->
    <View
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/overlay_colorful" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:visibility="gone"
        android:indeterminate="true"
        android:layout_gravity="center"
        app:indicatorColor="@color/vibrant_teal"
        app:trackColor="@color/vibrant_coral_light"
        app:trackThickness="4dp"
        app:indicatorSize="48dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>